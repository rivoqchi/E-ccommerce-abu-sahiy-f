# Frontend (Next.js)
# Local: cp .env.example .env.local
#
# Vercel: Project → Settings → Environment Variables
#   NEXT_PUBLIC_SITE_URL = https://your-app.vercel.app
#   NEXT_PUBLIC_API_URL  = https://your-api.example.com/api/v1
#   NEXT_PUBLIC_WS_URL   = https://your-api.example.com   (ixtiyoriy)

# Sayt manzili (SEO, metadata, sitemap)
# Vercel'da bo'sh qoldirilsa VERCEL_URL dan olinadi
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Backend API base URL (oxirida /api/v1)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Socket.io / realtime (ixtiyoriy — bo'sh qoldirilsa API hostidan olinadi)
NEXT_PUBLIC_WS_URL=http://localhost:4000

# Telegram bot username (@siz)
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=samipricebot
