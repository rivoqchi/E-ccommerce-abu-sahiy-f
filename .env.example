# Frontend (Next.js) — barcha base URL lar faqat shu yerda
# Nusxa: cp .env.example .env.local

# Sayt manzili (SEO, metadata, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Backend API base URL (oxirida /api/v1)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Socket.io / realtime (ixtiyoriy — bo'sh qoldirilsa API hostidan olinadi)
NEXT_PUBLIC_WS_URL=http://localhost:4000
